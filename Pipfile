[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[scripts]
start = "python -m src.main"
serve = "python -m src.server"
test = "pytest -s"
watch = "ptw --config pytest.ini --runner 'pytest --testmon -s'"
check = "pre-commit run --all-files"
fix = "sh -c 'ruff check . --fix && black .'"

[packages]
openai-whisper = "*"
pyaudio = "*"
numpy = "*"
scipy = "*"
aiortc = "*"
aiohttp = "*"

[dev-packages]
pytest = "*"
pytest-watch = "*"
pytest-testmon = "*"
datasets = "*"
pre-commit = "*"
black = "*"
ruff = "*"

[requires]
python_version = "3.13"
